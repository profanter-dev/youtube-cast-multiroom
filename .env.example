# Where persistent data lives on the host (snapfifo + musicbridge auth).
DATA_DIR=/opt/youtube-cast-multiroom

# Timezone for the nightly cookie check and log timestamps (e.g. Europe/Berlin).
TZ=UTC

# Hostnames routed by Traefik.
MUSIC_HOST=music.example.com
SNAPCAST_HOST=snapcast.example.com

# OPTIONAL basic-auth for the music web UI (htpasswd user:hash pair). The default
# compose does NOT enable auth — only needed if you add the basic-auth middleware
# (see README → Security), e.g. when exposing it to the internet.
# Generate with:  htpasswd -nbB youruser yourpassword
# IMPORTANT: in this .env file, every literal "$" must be doubled to "$$".
MUSIC_AUTH=youruser:$$2y$$05$$replace.with.your.bcrypt.hash

# Cookie keeper: musicbridge checks + refreshes the YouTube Music cookie at startup
# and once a night at this local time (it waits while music is playing).
COOKIE_REFRESH_AT=04:00

# OPTIONAL: URL that gets a JSON POST {"event","title","message"} when the cookie
# stops working — e.g. a Home Assistant webhook trigger:
#   http://<home-assistant-host>:8123/api/webhook/<your-webhook-id>
NOTIFY_WEBHOOK_URL=
